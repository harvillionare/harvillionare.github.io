# harville.me/pc: lets Michael's Mac Studio reach this Windows PC for remote help. It installs
# ZeroTier, joins harville-network, and turns on Windows' SSH server for harvillionare's keys,
# open only to that network. Paste into a PowerShell window opened with "Run as administrator":
#
#   irm harville.me/pc | iex
#
# Running it again is safe: it skips what is already done.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'    # the progress bar makes downloads many times slower

$network = '633e31d8a28b07f7'
$subnet = '10.121.40.0/24'
$keysUrl = 'https://github.com/harvillionare.keys'

$me = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if (-not $me.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host 'This needs an administrator window: right-click PowerShell, choose "Run as administrator", and paste it again.'
    return
}

# 1. ZeroTier: the private network the Mac Studio is on.
$zerotier = "${env:ProgramFiles(x86)}\ZeroTier\One\zerotier-cli.bat"
if (-not (Test-Path $zerotier)) {
    Write-Host 'Installing ZeroTier...'
    $installer = Join-Path $env:TEMP 'ZeroTierOne.msi'
    Invoke-WebRequest 'https://download.zerotier.com/dist/ZeroTier%20One.msi' -OutFile $installer -UseBasicParsing
    $install = Start-Process msiexec.exe -ArgumentList "/i `"$installer`" /qn /norestart" -Wait -PassThru
    if ($install.ExitCode -ne 0) { throw "ZeroTier's installer ended with code $($install.ExitCode)." }
}
$address = $null
foreach ($try in 1..30) {    # the service takes a little while to answer after an install
    try { $info = (& $zerotier info 2>&1 | Out-String) } catch { $info = '' }
    if ($info -match '200 info (\w+)') { $address = $Matches[1]; break }
    Start-Sleep 2
}
if (-not $address) { throw 'ZeroTier is installed but its service is not answering. Restart the PC and run this again.' }
$joined = & $zerotier join $network | Out-String
if ($joined -notmatch '200 join OK') { throw "ZeroTier would not join the network: $joined" }

# 2. Windows' own SSH server, started with Windows.
$hadSsh = [bool](Get-Service sshd -ErrorAction SilentlyContinue)
if (-not $hadSsh) {
    Write-Host 'Adding the Windows SSH server (this can take a few minutes)...'
    Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0 | Out-Null
}
Set-Service sshd -StartupType Automatic
Start-Service sshd

# 3. Who may sign in: harvillionare's keys, added to any keys already there. Windows ignores this
#    file unless only administrators and the system can change it (S-1-5-32-544 and S-1-5-18).
$keyFile = "$env:ProgramData\ssh\administrators_authorized_keys"
$have = @(if (Test-Path $keyFile) { Get-Content $keyFile })
$wanted = @((Invoke-WebRequest $keysUrl -UseBasicParsing).Content -split "`n" | ForEach-Object { $_.Trim() } | Where-Object { $_ })
if (-not $wanted) { throw "No keys came back from $keysUrl." }
$known = @($have | ForEach-Object { (-split $_)[0..1] -join ' ' })    # a key is its first two words; a name may follow
Set-Content -Path $keyFile -Encoding ascii -Value ($have + @($wanted | Where-Object { $known -notcontains $_ }))
icacls $keyFile /inheritance:r /grant '*S-1-5-32-544:F' /grant '*S-1-5-18:F' | Out-Null

# 4. The firewall lets SSH in from the ZeroTier network only. Windows adds its own rule with the
#    server, open to every network: that one is switched off, unless SSH was here before this ran.
if (-not (Get-NetFirewallRule -Name sshd-zerotier -ErrorAction SilentlyContinue)) {
    New-NetFirewallRule -Name sshd-zerotier -DisplayName 'OpenSSH (ZeroTier)' -Protocol TCP -LocalPort 22 `
        -RemoteAddress $subnet -Action Allow | Out-Null
}
if (-not $hadSsh) { Disable-NetFirewallRule -Name OpenSSH-Server-In-TCP -ErrorAction SilentlyContinue }

Write-Host ''
Write-Host 'Done. Send Michael these two lines:'
Write-Host "  ZeroTier address: $address"
Write-Host "  Windows user:     $(whoami)"
